## Production template for docker-compose.prod.yml. Copy it to .env.production
## on the server, fill it in, and never commit it. See docs/technique/exploitation.md.

# Domains (DNS A/AAAA records pointing to the server) and Let's Encrypt contact.
ACME_EMAIL=admin@workhoraire.example
SITE_HOST=workhoraire.example
APP_HOST=app.workhoraire.example
API_HOST=api.workhoraire.example
AUTH_HOST=auth.workhoraire.example

# Database (long random password).
POSTGRES_DB=workhoraire
POSTGRES_USER=workhoraire
POSTGRES_PASSWORD=<LONG_RANDOM_PASSWORD>

# Keycloak administrator (reachable only through an SSH tunnel to 127.0.0.1:8180).
KEYCLOAK_ADMIN=<ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<LONG_RANDOM_PASSWORD>

# Encrypted backups: keep the passphrase ALSO outside the server (password
# manager), otherwise the backups cannot be restored after losing the server.
BACKUP_PASSPHRASE=<LONG_RANDOM_PASSPHRASE>
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups

# Transactional e-mails (invitations; Keycloak uses its own realm settings).
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
MAIL_FROM=WorkHoraire <no-reply@workhoraire.example>

# Online payment (Stripe). Leave STRIPE_SECRET_KEY empty to keep WorkHoraire free
# for everyone. Setup (meter, price, webhook): docs/technique/exploitation.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=active_employees
# French VAT (20 %) added to the invoices: ID of a Stripe tax rate (txr_...).
STRIPE_TAX_RATE_ID=

# Keycloak's own e-mails and mandatory address verification, applied after the
# first start by `node infrastructure/keycloak/apply-realm-settings.mjs --env-file .env.production`
# (through the SSH tunnel: KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180).
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_SMTP_HOST=<SMTP_HOST>
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_FROM=no-reply@workhoraire.example
KEYCLOAK_SMTP_USER=<SMTP_USER>
KEYCLOAK_SMTP_PASSWORD=<SMTP_PASSWORD>
KEYCLOAK_VERIFY_EMAIL=true
