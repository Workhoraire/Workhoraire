## Production template for docker-compose.prod.yml. Copy it to .env.production
## on the server, fill it in, and never commit it. See docs/technique/exploitation.md.
##
## Passwords and passphrases: letters and digits only (no $ @ # / % : quote or
## space: they go into connection URLs), 16 characters at least. Generate each
## one with `openssl rand -hex 32`. infrastructure/server/deploy.sh refuses the
## <…> placeholders, the example domains and any other password.

# Domains (DNS A records pointing to the server, `www` included) and Let's Encrypt contact.
ACME_EMAIL=admin@workhoraire.example
SITE_HOST=workhoraire.example
APP_HOST=app.workhoraire.example
API_HOST=api.workhoraire.example
AUTH_HOST=auth.workhoraire.example

# Database. Separate roles: Keycloak owns its schema, the API only reads and
# writes data. deploy.sh applies these passwords to the roles at each deployment.
POSTGRES_DB=workhoraire
POSTGRES_USER=workhoraire
POSTGRES_PASSWORD=<LONG_RANDOM_PASSWORD>
KEYCLOAK_DB_PASSWORD=<LONG_RANDOM_PASSWORD>
API_DB_PASSWORD=<LONG_RANDOM_PASSWORD>

# Keycloak administrator (reachable only through an SSH tunnel to 127.0.0.1:8180).
# Keycloak creates it at its first start only: change it afterwards in its console.
KEYCLOAK_ADMIN=<ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<LONG_RANDOM_PASSWORD>

# Encrypted backups: keep the passphrase ALSO outside the server (password
# manager), otherwise the backups cannot be restored after losing the server.
BACKUP_PASSPHRASE=<LONG_RANDOM_PASSPHRASE>
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
# Schedule of the nightly backup (cron syntax, UTC).
BACKUP_CRON=0 3 * * *
# Pinged after every complete backup, e.g. a healthchecks.io check expecting
# one ping a day: a missing ping raises an alert. Empty: no ping.
BACKUP_HEARTBEAT_URL=

# Copy of every (already encrypted) dump to an S3-compatible object storage of
# another provider, in the EU. Leave BACKUP_OFFSITE empty to keep local copies only.
# When set, also fill `offsiteBackup` in site/src/app/core/legal/legal-info.json.
# BACKUP_OFFSITE=offsite:<bucket>/workhoraire
BACKUP_OFFSITE=
# rclone's name of the provider (Scaleway, Ovh, AWS…), or Other.
OFFSITE_S3_PROVIDER=Other
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_REGION=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# true: the server also deletes the copies older than BACKUP_RETENTION_DAYS
# (the key then needs the right to list and delete). Better: a lifecycle rule.
BACKUP_OFFSITE_PRUNE=false

# Transactional e-mails (invitations; Keycloak uses its own realm settings).
# Empty SMTP_HOST: nothing is sent (the invitation link is still shown).
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
MAIL_FROM=WorkHoraire <no-reply@workhoraire.example>

# Online payment (Stripe). Leave STRIPE_SECRET_KEY empty to keep WorkHoraire free
# for everyone. Setup (meter, price, webhook): docs/technique/exploitation.md.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=active_employees
# ID of a Stripe tax rate (txr_...) for French VAT (20 %), added to the invoices.
# Leave it empty under the VAT franchise (art. 293 B du CGI): no VAT is charged.
STRIPE_TAX_RATE_ID=

# Keycloak's own e-mails, mandatory address verification and the other realm
# settings, applied after the first start by
# `infrastructure/keycloak/apply-realm-settings.mjs --env-file .env.production`
# (on the server: KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180).
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_SMTP_HOST=<SMTP_HOST>
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_FROM=no-reply@workhoraire.example
KEYCLOAK_SMTP_USER=<SMTP_USER>
KEYCLOAK_SMTP_PASSWORD=<SMTP_PASSWORD>
KEYCLOAK_VERIFY_EMAIL=true
