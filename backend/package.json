{
  "name": "workhoraire-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST de WorkHoraire",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "node --env-file=../.env node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file=../.env node_modules/prisma/build/index.js validate",
    "prisma:migrate": "node --env-file=../.env node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "keycloak-connect": "^26.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
