{
  "name": "workhoraire-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST de WorkHoraire",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "node --env-file=../.env node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file=../.env node_modules/prisma/build/index.js validate",
    "prisma:migrate": "node --env-file=../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file=../.env node_modules/prisma/build/index.js migrate deploy",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "node --env-file=../.env node_modules/jest/bin/jest.js --config test/jest-e2e.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "keycloak-connect": "^26.1.1",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
