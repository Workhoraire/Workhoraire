generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(120)
  siret           String?   @unique @db.VarChar(14)
  timezone        String    @default("Europe/Paris") @db.VarChar(64)
  /// Terms of sale and data processing agreement accepted at the creation of the company (version = date of the text).
  termsAcceptedAt DateTime?
  termsVersion    String?   @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users              User[]
  invitations        EmployeeInvitation[]
  timeEntries        TimeEntry[]
  timeEntryAuditLogs TimeEntryAuditLog[]
  absenceRequests    AbsenceRequest[]
  contractPeriods    ContractPeriod[]
  subscription       Subscription?
  billingUsages      BillingUsage[]
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  keycloakSubject       String               @unique @db.VarChar(255)
  email                 String?              @db.VarChar(320)
  firstName             String?              @db.VarChar(100)
  lastName              String?              @db.VarChar(100)
  isActive              Boolean              @default(true)
  role                  UserRole             @default(EMPLOYEE)
  /// Contractual weekly working time in force today, in minutes (2100 = 35 h).
  /// The dated history used by calculations is in ContractPeriod.
  weeklyContractMinutes Int                  @default(2100)
  /// Employee number in the payroll software (matricule), used in exports.
  payrollId             String?              @db.VarChar(50)
  companyId             String               @db.Uuid
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sentInvitations       EmployeeInvitation[] @relation("EmployeeInvitations")
  acceptedInvitations   EmployeeInvitation[] @relation("AcceptedInvitations")
  timeEntries           TimeEntry[]          @relation("EmployeeTimeEntries")
  createdTimeEntries    TimeEntry[]          @relation("TimeEntryCreators")
  timeEntryAuditLogs    TimeEntryAuditLog[]  @relation("TimeEntryAuditEmployees")
  timeEntryAuditActions TimeEntryAuditLog[]  @relation("TimeEntryAuditActors")
  absenceRequests       AbsenceRequest[]     @relation("EmployeeAbsenceRequests")
  reviewedAbsences      AbsenceRequest[]     @relation("AbsenceRequestReviewers")
  contractPeriods       ContractPeriod[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([companyId, payrollId])
  @@index([companyId])
}

/// Contractual weekly working time applicable from a given week, so that a
/// contract change never rewrites the hours of past weeks.
model ContractPeriod {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid
  userId                String   @db.Uuid
  /// Monday of the first civil week concerned.
  effectiveFrom         DateTime @db.Date
  weeklyContractMinutes Int
  createdAt             DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, effectiveFrom])
  @@index([companyId])
}

model EmployeeInvitation {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @db.VarChar(320)
  firstName             String    @db.VarChar(100)
  lastName              String    @db.VarChar(100)
  role                  UserRole  @default(EMPLOYEE)
  weeklyContractMinutes Int       @default(2100)
  tokenHash             String    @unique @db.VarChar(64)
  companyId             String    @db.Uuid
  invitedById           String    @db.Uuid
  expiresAt             DateTime
  acceptedAt            DateTime?
  /// The account created by accepting the invitation.
  acceptedById          String?   @db.Uuid
  createdAt             DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitedBy  User    @relation("EmployeeInvitations", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?   @relation("AcceptedInvitations", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([email])
}

enum TimeEntrySource {
  /// Clocked in real time by the employee.
  CLOCK
  /// Entered after the fact by a manager or an administrator.
  MANUAL
}

/// A continuous period of work. A break is the gap between two entries.
model TimeEntry {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @db.Uuid
  userId         String          @db.Uuid
  startAt        DateTime
  endAt          DateTime?
  /// Equals userId while the entry is open. The unique index guarantees a
  /// single open entry per employee, even under concurrent requests.
  openUserId     String?         @unique @db.Uuid
  source         TimeEntrySource @default(CLOCK)
  note           String?         @db.VarChar(500)
  /// Set when the employee was reminded by e-mail of a forgotten clock-out, so that it is sent once.
  reminderSentAt DateTime?
  createdById    String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User    @relation("EmployeeTimeEntries", fields: [userId], references: [id], onDelete: Restrict)
  createdBy User    @relation("TimeEntryCreators", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, startAt])
  @@index([userId, startAt])
}

enum TimeEntryAuditAction {
  CREATED
  UPDATED
  DELETED
}

/// Append-only trail of every manual change made to a time entry.
model TimeEntryAuditLog {
  id           String               @id @default(uuid()) @db.Uuid
  companyId    String               @db.Uuid
  /// Deliberately not a foreign key: the trail must outlive a deleted entry.
  timeEntryId  String               @db.Uuid
  employeeId   String               @db.Uuid
  actorId      String               @db.Uuid
  action       TimeEntryAuditAction
  reason       String               @db.VarChar(500)
  /// Start of the entry concerned (after the change, or before a deletion).
  entryStartAt DateTime
  before       Json?
  after        Json?
  createdAt    DateTime             @default(now())

  company  Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee User    @relation("TimeEntryAuditEmployees", fields: [employeeId], references: [id], onDelete: Restrict)
  actor    User    @relation("TimeEntryAuditActors", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([companyId, entryStartAt])
  @@index([timeEntryId])
  @@index([employeeId, entryStartAt])
}

enum AbsenceType {
  PAID_LEAVE
  RTT
  SICK_LEAVE
  UNPAID_LEAVE
  FAMILY_EVENT
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model AbsenceRequest {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @db.Uuid
  userId          String        @db.Uuid
  type            AbsenceType
  status          AbsenceStatus @default(PENDING)
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  /// The first day only covers the afternoon.
  startsAfternoon Boolean       @default(false)
  /// The last day only covers the morning.
  endsMorning     Boolean       @default(false)
  comment         String?       @db.VarChar(500)
  reviewComment   String?       @db.VarChar(500)
  reviewedById    String?       @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user       User    @relation("EmployeeAbsenceRequests", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("AbsenceRequestReviewers", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([companyId, startDate])
  @@index([userId, startDate])
}

enum PlanCode {
  DECOUVERTE
  ESSENTIEL
}

enum SubscriptionStatus {
  /// Free plan, no payment method.
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Billing state of a company. Payment data stays at Stripe: only its identifiers are kept.
model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  companyId            String             @unique @db.Uuid
  plan                 PlanCode           @default(DECOUVERTE)
  status               SubscriptionStatus @default(NONE)
  stripeCustomerId     String?            @unique @db.VarChar(255)
  stripeSubscriptionId String?            @unique @db.VarChar(255)
  /// Start of the current paid subscription: only the months from this one onward are billed.
  subscribedAt         DateTime?
  /// First time the company needed a payment method (more than 3 active employees): the grace period starts there.
  paymentRequiredSince DateTime?
  /// When the administrators received the e-mail about the current grace period.
  paymentWarningSentAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
}

/// Active employees counted for a month, and when they were reported to Stripe.
model BillingUsage {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  /// First day of the month, in the company timezone.
  month           DateTime  @db.Date
  activeEmployees Int
  amountCents     Int
  reportedAt      DateTime?
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, month])
}

/// Proof that a closed company accepted the terms of sale and the data
/// processing agreement, kept 5 years after its deletion (privacy policy).
model TermsAcceptanceArchive {
  id                  String   @id @default(uuid()) @db.Uuid
  /// Identifier of the deleted company (no foreign key: the company is gone).
  companyId           String   @db.Uuid
  companyName         String   @db.VarChar(120)
  siret               String?  @db.VarChar(14)
  administratorEmails String[]
  termsAcceptedAt     DateTime
  termsVersion        String?  @db.VarChar(20)
  closedAt            DateTime @default(now())
}

/// Stripe events already handled: a replayed webhook changes nothing.
model ProcessedWebhook {
  id         String   @id @db.VarChar(255)
  receivedAt DateTime @default(now())
}
