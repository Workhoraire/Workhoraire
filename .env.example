## Local development template only. Never use these values in production.
PORT=3000
FRONTEND_URL=http://localhost:4200

POSTGRES_DB=workhoraire
POSTGRES_USER=workhoraire
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_PORT=5432

DATABASE_URL=postgresql://workhoraire:<YOUR_POSTGRES_PASSWORD>@localhost:5432/workhoraire?schema=public

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=<YOUR_KEYCLOAK_ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<YOUR_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=workhoraire
KEYCLOAK_CLIENT_ID=workhoraire-api
KEYCLOAK_SSL_REQUIRED=none
