## Local development template only. Never use these values in production.
PORT=3000
FRONTEND_URL=http://localhost:4200

POSTGRES_DB=workhoraire
POSTGRES_USER=workhoraire
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_PORT=5432

DATABASE_URL=postgresql://workhoraire:<YOUR_POSTGRES_PASSWORD>@localhost:5432/workhoraire?schema=public
# Dedicated database for `npm run test:e2e`: it is wiped on every run.
E2E_DATABASE_URL=postgresql://workhoraire:<YOUR_POSTGRES_PASSWORD>@localhost:5432/workhoraire_e2e?schema=public

KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=<YOUR_KEYCLOAK_ADMIN_USERNAME>
KEYCLOAK_ADMIN_PASSWORD=<YOUR_KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=workhoraire
KEYCLOAK_CLIENT_ID=workhoraire-api
# Accepting an invitation and creating a company require an e-mail address
# verified by Keycloak, locally too: Keycloak's verification e-mails reach Mailpit.
# false is refused by the API in production (NODE_ENV=production).
KEYCLOAK_REQUIRE_VERIFIED_EMAIL=true

# Transactional e-mails (invitations, correction notices). In development they
# go to the Mailpit test mailbox of docker-compose.yml: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=WorkHoraire <no-reply@workhoraire.localhost>

# Keycloak's own e-mails (address verification, forgotten password), applied by
# `node infrastructure/keycloak/apply-realm-settings.mjs`. The host is seen from the
# Keycloak container: `mailpit` in development.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=no-reply@workhoraire.localhost
# The realm requires verified e-mail addresses; keep it locally too (Mailpit receives them).
KEYCLOAK_VERIFY_EMAIL=true

# Online payment (Stripe, test mode keys only in development). Empty: payments
# are disabled, the subscription page only shows the usage.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=active_employees
STRIPE_TAX_RATE_ID=
