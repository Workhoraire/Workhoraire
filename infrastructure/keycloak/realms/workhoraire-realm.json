{
  "realm": "workhoraire",
  "enabled": true,
  "displayName": "WorkHoraire",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full access to the company administration"
      },
      {
        "name": "MANAGER",
        "description": "Management access to company operations"
      },
      {
        "name": "EMPLOYEE",
        "description": "Access to the employee time tracking features"
      }
    ]
  },
  "clients": [
    {
      "clientId": "workhoraire-api",
      "name": "WorkHoraire API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "workhoraire-web",
      "name": "WorkHoraire Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "workhoraire-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "workhoraire-api",
            "included.custom.audience": "",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ]
}
