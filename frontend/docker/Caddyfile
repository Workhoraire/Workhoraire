# Serves the Angular build behind the edge proxy (infrastructure/caddy).
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed bundles never change; everything else (index.html, config.json) is revalidated.
	@hashed path_regexp -[A-Z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css|woff2?)$
	header @unhashed Cache-Control "no-cache"

	# Single-page application: a path without an extension is an Angular route,
	# answered with index.html. A missing file with an extension (a hashed chunk
	# of the previous version after a deployment) is a real 404: the application
	# then reloads, instead of receiving index.html as JavaScript.
	@route not path_regexp \.[A-Za-z0-9]+$
	handle @route {
		try_files {path} /index.html
		file_server
	}
	handle {
		file_server
	}
}
