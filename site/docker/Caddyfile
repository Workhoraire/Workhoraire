# Serves the pre-rendered site behind the edge proxy (infrastructure/caddy).
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed bundles and fonts never change; pages are revalidated.
	@hashed path_regexp -[A-Z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path_regexp -[A-Z0-9]{8}\.(js|css|woff2?)$
	header @unhashed Cache-Control "no-cache"

	# /tarifs is served by tarifs/index.html; anything else is a real 404.
	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
