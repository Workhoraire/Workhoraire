# Serves the pre-rendered site behind the edge proxy (infrastructure/caddy).
{
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed bundles and fonts never change. Images keep their names: cached one
	# day. Pages, robots.txt and sitemap.xml are revalidated.
	@hashed path_regexp -[A-Z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@images path_regexp \.(png|svg)$
	header @images Cache-Control "public, max-age=86400"
	@revalidated not path_regexp (-[A-Z0-9]{8}\.(js|css|woff2?)|\.(png|svg))$
	header @revalidated Cache-Control "no-cache"

	# /tarifs is served by tarifs/index.html; anything else is a real 404.
	try_files {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
